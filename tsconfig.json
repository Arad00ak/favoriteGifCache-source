{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx"
  },
  "include": ["plugin/**/*.ts", "plugin/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts"]
}
